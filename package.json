{
  "name": "linbar",
  "productName": "LinBar",
  "version": "1.0.0",
  "description": "LinBar — a Linux-desktop-style bottom taskbar for macOS (live windows, quick launch, tray).",
  "author": "Giorgio Gozali <giorgi.gozalishvili@keytype.it>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "build:helper": "swiftc -O helper/main.swift -o helper/linbar-helper -framework Cocoa -framework ApplicationServices",
    "build:brightness": "swiftc -O helper/brightness.swift -o helper/linbar-brightness -framework CoreGraphics -framework IOKit",
    "build:panel": "node scripts/build-panel.js",
    "postinstall": "(npm run build:helper || echo 'helper build failed; window tracking will use AppleScript fallback') && (npm run build:brightness || echo 'brightness build failed; brightness control unavailable') && (npm run build:panel || echo 'panel addon build failed; Mission Control overlay behavior unavailable')"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.linbar.app",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "LinBar ${version}"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "helper/linbar-helper",
      "helper/linbar-brightness",
      "helper/build/Release/linbar_panel.node",
      "build/trayTemplate.png"
    ],
    "asarUnpack": [
      "helper/linbar-helper",
      "helper/linbar-brightness",
      "helper/build/Release/linbar_panel.node"
    ]
  }
}
