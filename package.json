{
  "name": "linbar",
  "productName": "LinBar",
  "version": "1.0.0",
  "description": "LinBar — a Linux-desktop-style bottom taskbar for macOS (live windows, quick launch, tray).",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "build:helper": "swiftc -O helper/main.swift -o helper/linbar-helper -framework Cocoa -framework ApplicationServices",
    "postinstall": "npm run build:helper || echo 'swiftc unavailable; LinBar will use the AppleScript fallback'"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.linbar.app",
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg", "zip"]
    },
    "files": ["main.js", "preload.js", "lib/**", "renderer/**", "helper/linbar-helper"]
  }
}
