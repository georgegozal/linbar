{
  "name": "linbar",
  "productName": "LinBar",
  "version": "1.0.0",
  "description": "LinBar — a Linux-desktop-style bottom taskbar for macOS (live windows, quick launch, tray).",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "build:helper": "swiftc -O helper/main.swift -o helper/linbar-helper -framework Cocoa -framework ApplicationServices",
    "build:brightness": "swiftc -O helper/brightness.swift -o helper/linbar-brightness -framework CoreGraphics -framework IOKit",
    "postinstall": "npm run build:helper && npm run build:brightness || echo 'swiftc unavailable; some native features may be limited'"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.linbar.app",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "target": ["dmg", "zip"]
    },
    "dmg": {
      "title": "LinBar ${version}"
    },
    "files": ["main.js", "preload.js", "lib/**", "renderer/**", "helper/linbar-helper", "helper/linbar-brightness", "build/trayTemplate.png"],
    "asarUnpack": ["helper/linbar-helper", "helper/linbar-brightness"]
  }
}
